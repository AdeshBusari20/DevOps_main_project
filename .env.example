# ==============================================
# AI Expense Tracker - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ==============================================

# ---- Application ----
APP_NAME=ai-expense-tracker
APP_ENV=development
DEBUG=true

# ---- Backend ----
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256

# ---- Database ----
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_pass_change_me
POSTGRES_DB=expense_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://expense_user:expense_pass_change_me@postgres:5432/expense_tracker

# ---- Frontend ----
REACT_APP_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# ---- Docker Hub ----
DOCKERHUB_USERNAME=adeshbusari20
DOCKERHUB_TOKEN=your-dockerhub-access-token

# ---- Jenkins ----
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# ---- SonarQube ----
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your-sonarqube-token

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-change-me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ---- AWS ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
