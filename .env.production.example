# ==============================================
# AI Expense Tracker - Production Environment
# ==============================================
# Copy to .env and configure for production deployment
# NEVER commit the actual .env file to version control!
#
# Usage: cp .env.production.example .env
# ==============================================

# ---- Application ----
APP_NAME=ai-expense-tracker
APP_ENV=production
DEBUG=false

# ---- Backend ----
BACKEND_PORT=8000
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
ALGORITHM=HS256

# ---- Database (use strong passwords!) ----
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=expense_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://expense_user:CHANGE_ME_USE_STRONG_PASSWORD_32_CHARS@postgres:5432/expense_tracker

# ---- Frontend ----
# Replace YOUR_SERVER_IP with your EC2 public IP or domain
REACT_APP_API_URL=http://YOUR_SERVER_IP/api/v1
FRONTEND_PORT=3000

# ---- Docker Hub ----
DOCKERHUB_USERNAME=adeshbusari20

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ---- Server (auto-populated by deploy script) ----
PUBLIC_IP=YOUR_SERVER_IP
DOMAIN=YOUR_SERVER_IP.nip.io

# ==============================================
# Generate strong passwords with:
#   openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
#
# Generate SECRET_KEY with:
#   openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64
# ==============================================
